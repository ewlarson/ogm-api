APPLICATION_URL=http://localhost:8000
OPENGEOMETADATA_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:2345/opengeometadata_api
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=opengeometadata_api
ELASTICSEARCH_DISK_THRESHOLD_ENABLED=false
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=changeme
LOG_PATH=logs
LOG_LEVEL=DEBUG
CORS_ORIGINS=*

# Database pool sizing
DB_POOL_MIN=1
DB_POOL_MAX=10

# Redis / caching
ENDPOINT_CACHE=true
CACHE_DEBUG_HEADERS=false
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_PORT=6380
REDIS_DB=0
REDIS_TTL=604800
GAZETTEER_CACHE_TTL=3600

# Admin / webhook
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
OGM_WEBHOOK_SECRET=changeme

# Optional AI features
OPENAI_API_KEY=
OPENAI_MODEL=
